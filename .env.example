# ==============================================================================
# Atlas MLOps Platform — Environment Configuration
# ==============================================================================

# Core & Security
ENVIRONMENT=production
DOMAIN=atlas.example.com
SECRET_KEY=change-this-to-a-very-secure-random-32-character-secret-key!
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL for Docker Compose, SQLite for local standalone)
DATABASE_URL=postgresql+psycopg://atlas:atlas_secret_pass@postgres:5432/atlas
# DATABASE_URL=sqlite:///./data/atlas.db

# Redis & Asynchronous Job Execution
REDIS_URL=redis://redis:6379/0
JOB_EXECUTION_MODE=celery
# JOB_EXECUTION_MODE=thread

# MLflow Experiment Tracking
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
MLFLOW_ARTIFACT_ROOT=/data/artifacts/mlflow

# Artifact Storage (Local volume or AWS S3 / MinIO)
STORAGE_BACKEND=local
ARTIFACT_ROOT=/data/artifacts
MAX_UPLOAD_MB=100

# S3 / MinIO Configuration (Optional, when STORAGE_BACKEND=s3)
# S3_BUCKET=my-atlas-artifacts
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# Prediction Serving & In-Memory Model Cache
MODEL_CACHE_SIZE=8
MODEL_CACHE_TTL_SECONDS=300
INFERENCE_THREADS=4
PREDICTION_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Continuous Monitoring & Drift Settings
ENABLE_MONITORING_SCHEDULER=true
MONITORING_INTERVAL_SECONDS=900
MONITORING_WINDOW_HOURS=24
MONITORING_MIN_SAMPLES=30
DRIFT_PSI_THRESHOLD=0.2
DRIFT_SHARE_THRESHOLD=0.3
PERFORMANCE_DEGRADATION_THRESHOLD=0.15
RETRAIN_COOLDOWN_HOURS=12

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_SERVICE_NAME=atlas-api
# Optional: set to an OTLP/HTTP collector base URL, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
DOCS_ENABLED=true
