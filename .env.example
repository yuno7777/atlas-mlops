# Docker Compose reads this file after it is copied to .env.
# Generate separate random values with: openssl rand -hex 32
SECRET_KEY=
# Use URL-safe characters because Compose interpolates this into a database URL.
POSTGRES_PASSWORD=
POSTGRES_USER=atlas
POSTGRES_DB=atlas
MLFLOW_POSTGRES_DB=atlas_mlflow

# Required for the production Caddy overlay.
DOMAIN=atlas.example.com
# The production overlay defaults to closed registration and disabled API docs.
ATLAS_PRODUCTION_ALLOW_REGISTRATION=false
ATLAS_PRODUCTION_DOCS_ENABLED=false
# Local Compose switches.
ALLOW_REGISTRATION=true
DOCS_ENABLED=true

LOG_LEVEL=INFO
ENABLE_MONITORING_SCHEDULER=true
INFERENCE_THREADS=4
INFERENCE_TIMEOUT_SECONDS=10
MAX_PREDICTION_BODY_BYTES=2097152
OTEL_SERVICE_NAME=atlas-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Standalone backend examples (export in the API/worker environment as needed).
# DATABASE_URL=sqlite:///./data/atlas.db
# JOB_EXECUTION_MODE=thread
# REDIS_URL=redis://127.0.0.1:6379/0
# MLFLOW_ENABLED=true
# MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
# MLFLOW_ARTIFACT_ROOT=./data/mlflow-artifacts
# ARTIFACT_ROOT=./data/artifacts
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# Prefer workload identity or the AWS credential chain.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
